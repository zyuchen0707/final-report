#include <iostream>
#include <ctime>
#include "rlutil.h"

using namespace std;

// 繪製單個線段的輔助函數
void drawSegment(int x, int y, bool horizontal) {
    rlutil::locate(x, y);
    if (horizontal) cout << "====="; 
    else cout << "||";
}

// 根據數字繪製七段顯示器 
void drawDigit(int x, int y, int num) {
    // 邏輯判斷：若數字包含該線段則繪製
    // 範例：數字 8 亮起所有線段
    if (num == 8) {
        drawSegment(x, y, true);      // 上
        drawSegment(x, y+2, true);    // 中
        drawSegment(x, y+4, true);    // 下
        // ...其餘垂直線段
    }
}

int main() {
    rlutil::saveDefaultColor(); // 儲存預設顏色 [cite: 167]
    rlutil::hidecursor();       // 隱藏游標 [cite: 182]
    rlutil::cls();              // 清空螢幕 [cite: 132]

    int color = rlutil::WHITE;

    while (true) {
        // 非阻塞式輸入檢查 [cite: 218]
        if (rlutil::kbhit()) {
            char k = rlutil::getch(); // 讀取按鍵 [cite: 196]
            if (k == 27) break;       // ESC 退出 (KEY_ESCAPE) [cite: 242]
            if (k == '1') color = rlutil::LIGHTRED;
            if (k == '2') color = rlutil::LIGHTGREEN;
        }

        // 取得並顯示時間
        time_t t = time(0);
        struct tm * now = localtime(&t);
        
        rlutil::setColor(color); // 設定顏色 [cite: 155]
        drawDigit(5, 5, now->tm_hour / 10);
        drawDigit(15, 5, now->tm_hour % 10);
        // ... (省略分鐘與秒數繪製)

        rlutil::msleep(200); // 暫停 200 毫秒控制刷新率 [cite: 252]
    }

    rlutil::showcursor();  // 恢復游標 [cite: 184]
    rlutil::resetColor(); // 還原顏色 [cite: 176]
    return 0;
}
